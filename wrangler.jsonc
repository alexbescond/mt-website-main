{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mt-website-main",
  "account_id": "2956aa8b799d46de715a248f6ef2207d",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  // Attach the custom domain after its Cloudflare zone is ready (see DEPLOY.md).
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "run_worker_first": true },
  "vars": {
    "SITE_ORIGIN": "https://les-vacances-de-ma-tetine.com",
    "CHECKOUT_MODE": "demo",
    "SITE_INDEXABLE": "false",
    "LEGAL_APPROVED": "false"
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "mt-orders",
    "database_id": "d7c82687-ed9b-4607-82a7-80fea80e71f7",
    "migrations_dir": "migrations"
  }],
  // Enable R2 on this account, create the private EU bucket, then add this binding:
  // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "mt-private-photos", "jurisdiction": "eu" }],
  "kv_namespaces": [{ "binding": "SESSION", "id": "9f532fb7c2034ef29d5e63881533b225" }],
  "ratelimits": [{ "name": "CHECKOUT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1, "redact_query_string": true }
}
