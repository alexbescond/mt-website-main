---
import { books, PRICE_LABEL } from "../lib/catalog";
import Icon from "./Icon.astro";
---

<div class="book-grid">
  {Object.entries(books).map(([id, book], i) => (
    <article class={`book-card ${book.color}`}>
      <div class="book-image">
        <img
          src={book.image}
          width="1200"
          height="800"
          alt={
            id === "ski"
              ? "Une petite tétine découvre les joies du ski dans les montagnes enneigées"
              : "Une petite tétine prend le soleil au bord d’un lagon turquoise"
          }
          loading="lazy"
        />
        <span class="book-tag">
          <Icon name={book.icon} size={16} />
          {book.eyebrow}
        </span>
        <button
          class="preview-button"
          data-preview={id}
          aria-label={`Feuilleter ${book.title}`}
        >
          <Icon name="book" size={17} /> Feuilleter
        </button>
      </div>
      <div class="book-info">
        <div class="book-number">
          AVENTURE 0{i + 1}
          <span>DOUDOU OU TÉTINE</span>
        </div>
        <h3>{book.title}</h3>
        <p>{book.description}</p>
        <div class="book-purchase">
          <div class="price">
            {PRICE_LABEL}
            <span>Prix provisoire · livraison incluse*</span>
          </div>
          <a
            href={`/personnaliser?aventure=${id}`}
            class="round-link"
            aria-label={`Personnaliser ${book.title}`}
          >
            <Icon name="arrow" size={23} />
          </a>
        </div>
      </div>
    </article>
  ))}
</div>
<p class="quiet-note">
  Illustrations d’exemple avec Tétine. Votre histoire se prépare avec la photo
  du compagnon choisi. *France métropolitaine.
</p>
