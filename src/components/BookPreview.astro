---
import Icon from "./Icon.astro";
---

<dialog id="book-preview" aria-labelledby="preview-title">
  <div class="preview-top">
    <span class="eyebrow">QUELQUES PAGES POUR RÊVER</span>
    <button id="close-preview" class="icon-button" aria-label="Fermer l’aperçu">
      <Icon name="close" />
    </button>
  </div>
  <h2 id="preview-title">Le carnet de Tétine</h2>
  <div class="preview-spread">
    <img
      id="preview-image"
      src="/images/tetine-avion.webp"
      alt=""
      width="900"
      height="600"
    />
    <div>
      <span id="preview-chapter" class="eyebrow"></span>
      <h3 id="preview-subtitle"></h3>
      <p id="preview-text"></p>
    </div>
  </div>
  <div class="preview-controls">
    <button id="preview-prev" class="icon-button" aria-label="Page précédente">
      ←
    </button>
    <span id="preview-counter" aria-live="polite"></span>
    <button id="preview-next" class="icon-button" aria-label="Page suivante">
      →
    </button>
  </div>
  <p class="quiet-note">
    Extrait illustratif avec Tétine. Le texte et le personnage seront adaptés à
    votre enfant et à son compagnon.
  </p>
  <a
    id="preview-create"
    class="button"
    href="/personnaliser?aventure=tropiques"
  >
    Imaginer son histoire <Icon name="arrow" size={17} />
  </a>
</dialog>
<script src="../scripts/home.ts"></script>
