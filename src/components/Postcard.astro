---
import { getI18n } from "../lib/i18n";
const { t, catalog } = getI18n(Astro.url);
const { adventures } = catalog;
import { type AdventureId } from "../lib/catalog";
import PostcardStamp from "./PostcardStamp.astro";
interface Props { adventure: AdventureId; }
const { adventure } = Astro.props;
const item = adventures[adventure];
---
<div class={`postcard-scene ${adventure === "ski" ? "postcard-snow" : ""}`} aria-label={t("Exemple de carte postale, recto et verso")}>
  <div class="postcard-front">
    <img src={item.image} width="1200" height="800" loading="lazy" alt={t("Illustration d’exemple : {0}", item.title)} />
    <span>{item.title} <i>{t("Un petit coucou pour toi ♡")}</i></span>
  </div>
  <div class="postcard-back" aria-hidden="true">
    <div class="postcard-message"><strong>{t("Coucou Camille,")}</strong><p>{adventure === "ski" ? t("Aujourd’hui, j’ai fait mes premières traces dans la neige. Je t’envoie un flocon de tendresse !") : t("Le soleil me chatouille les pieds. J’ai trouvé un coquillage et j’ai pensé très fort à toi !")}</p><em>{t("Ta Tétine ♡")}</em></div>
    <div class="postcard-address"><PostcardStamp adventure={adventure} /><strong>{t("Pour Camille")}</strong><span>{t("À la maison")}</span><span>{t("Tout près de ton cœur")}</span></div>
  </div>
</div>
