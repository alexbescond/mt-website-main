---
import type { AdventureId } from "../lib/catalog";
import { postage } from "../lib/postage";
interface Props { adventure: AdventureId; instance?: string; hidden?: boolean; }
const { adventure, instance = "card", hidden = false } = Astro.props;
const stamp = postage[adventure];
const id = `postage-${instance}-${adventure}`;
---
<span class="postcard-postage" data-postage={adventure} hidden={hidden}>
  <svg viewBox="0 0 240 170" role="img" aria-label={`Timbre vintage : ${stamp.motif}. Tampon : ${stamp.office}.`}>
    <defs>
      <mask id={`${id}-edge`}>
        <rect x="124" y="10" width="108" height="145" fill="white" />
        {Array.from({ length: 14 }, (_, i) => <>
          <circle cx={126 + i * 8} cy="10" r="2" fill="black" />
          <circle cx={126 + i * 8} cy="155" r="2" fill="black" />
        </>)}
        {Array.from({ length: 18 }, (_, i) => <>
          <circle cx="124" cy={15 + i * 8} r="2" fill="black" />
          <circle cx="232" cy={15 + i * 8} r="2" fill="black" />
        </>)}
      </mask>
      <pattern id={`${id}-grain`} width="7" height="9" patternUnits="userSpaceOnUse">
        <path d="M1 2h1 M5 6h.5 M2 8h.5" stroke={stamp.ink} stroke-width=".6" opacity=".22" />
      </pattern>
      <pattern id={`${id}-hatch`} width="3" height="3" patternUnits="userSpaceOnUse">
        <path d="M0 3L3 0" stroke={stamp.ink} stroke-width=".35" opacity=".25" />
      </pattern>
      <path id={`${id}-arc`} d="M22 104 A40 40 0 0 1 102 104" />
      <path id={`${id}-lower-arc`} d="M24 104 A38 38 0 0 0 100 104" />
    </defs>
    <g mask={`url(#${id}-edge)`}>
      <rect x="124" y="10" width="108" height="145" fill={stamp.paper} />
      <rect x="124" y="10" width="108" height="145" fill={`url(#${id}-grain)`} />
      <g fill="none" stroke={stamp.ink} opacity=".8">
        <rect x="131" y="17" width="94" height="131" stroke-width="1" />
        <rect x="134" y="20" width="88" height="125" stroke-width=".45" />
        <path d="M137 48H219 M137 122H219" stroke-width=".6" />
        <ellipse cx="178" cy="85" rx="37" ry="34" fill={`url(#${id}-hatch)`} stroke-width=".6" />
        <path d={stamp.drawing} transform="translate(148 55) scale(.94)" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" />
      </g>
      <g fill={stamp.ink} text-anchor="middle" font-family="Georgia, serif" font-weight="bold">
        <text x="178" y="32" font-size="8" letter-spacing=".7">{stamp.lines[0]}</text>
        <text x="178" y="43" font-size="9" letter-spacing=".6">{stamp.lines[1]}</text>
        <text x="178" y="132" font-size="5.5" letter-spacing=".3">{stamp.caption}</text>
        <text x="178" y="141" font-size="4.8" letter-spacing=".65">★ POSTES IMAGINAIRES ★</text>
      </g>
    </g>
    <g class="postcard-postmark" transform="rotate(-13 62 104)" fill="none" stroke="currentColor" opacity=".64">
      <circle cx="62" cy="104" r="46" stroke-width="1.3" />
      <circle cx="62" cy="104" r="43" stroke-width=".5" stroke-dasharray="2 1" />
      <circle cx="62" cy="104" r="31" stroke-width=".8" />
      <path d="M105 87C121 76 133 99 149 87S177 99 194 87 M108 95C124 84 136 107 152 95S180 107 197 95 M109 103C125 92 137 115 153 103S181 115 198 103 M108 111C124 100 136 123 152 111S180 123 197 111" stroke-width="1.3" />
      <g fill="currentColor" stroke="none" text-anchor="middle" font-family="Georgia, serif">
        <text font-size="7.5" letter-spacing=".65"><textPath href={`#${id}-arc`} startOffset="50%">{stamp.office.toLocaleUpperCase("fr-FR")}</textPath></text>
        <text x="62" y="101" font-size="7" letter-spacing="1">BON VOYAGE</text>
        <path d="M40 108H84" stroke="currentColor" stroke-width=".5" />
        <text x="62" y="119" font-size="6" letter-spacing="1.1">★ AIR MAIL ★</text>
        <text font-size="5.5" letter-spacing="1"><textPath href={`#${id}-lower-arc`} startOffset="50%">COURRIER DU CŒUR</textPath></text>
      </g>
    </g>
  </svg>
</span>
