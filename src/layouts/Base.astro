---
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/fraunces";
import "../styles/site.css";
import "../styles/postcards.css";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import { SITE_NAME } from "../lib/catalog";
interface Props {
  title?: string;
  description?: string;
  minimal?: boolean;
}
const {
  title = "Ses petits compagnons, de très grandes aventures",
  description = "De 1 à 5 cartes postales personnalisées avec le doudou ou la tétine de votre enfant. Une carte expédiée chaque semaine, dès 5 € la carte par 5.",
  minimal = false,
} = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={`${title} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:image"
      content={new URL("/images/compagnons-voyage.webp", Astro.site)}
    />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <div class="announcement">
      <Icon name="sparkles" size={14} />
      <span>De petits compagnons. Des souvenirs pour longtemps.</span>
      <Icon name="sparkles" size={14} />
    </div>
    <header class="site-header wrap">
      <Logo />
      {!minimal && (
        <nav class="desktop-nav" aria-label="Navigation principale">
          <a
            href="/aventures"
            aria-current={path === "/aventures" ? "page" : undefined}
          >
            Les aventures
          </a>
          <a href="/#comment-ca-marche">Le concept</a>
          <a
            href="/notre-histoire"
            aria-current={path === "/notre-histoire" ? "page" : undefined}
          >
            Notre histoire
          </a>
          <a href="/#tarifs">Les tarifs</a>
          <a href="/#questions">Vos questions</a>
        </nav>
      )}
      <a
        class={minimal ? "back-link" : "button button-small header-cta"}
        href={minimal ? "/aventures" : "/personnaliser"}
      >
        {minimal ? "← Les aventures" : "Créer ses cartes"}
        {!minimal && <Icon name="arrow" size={16} />}
      </a>
      {!minimal && (
        <button
          class="menu-toggle icon-button"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Ouvrir le menu"
        >
          <span></span>
          <span></span>
        </button>
      )}
    </header>
    {!minimal && (
      <nav
        id="mobile-nav"
        class="mobile-nav"
        aria-label="Navigation mobile"
        hidden
      >
        <a href="/aventures">Les aventures</a>
        <a href="/#comment-ca-marche">Le concept</a>
        <a href="/notre-histoire">Notre histoire</a>
        <a href="/#tarifs">Les tarifs</a>
          <a href="/#questions">Vos questions</a>
        <a href="/personnaliser">Créer ses cartes →</a>
      </nav>
    )}
    <main id="contenu">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-top">
        <div>
          <Logo />
          <p>
            Leurs petits compagnons ont tant
            <br />
            de petits mots à leur envoyer.
          </p>
        </div>
        <div class="footer-links">
          <span class="eyebrow">PARTIR À LA DÉCOUVERTE</span>
          <a href="/aventures">Toutes les aventures</a>
          <a href="/#comment-ca-marche">Comment ça marche</a>
          <a href="/notre-histoire">Notre histoire</a>
        </div>
        <div class="footer-links">
          <span class="eyebrow">PRÉPARER LE VOYAGE</span>
          <a href="/#questions">Questions fréquentes</a>
          <a href="/informations#confidentialite">
            Vos photos, votre confiance
          </a>
          <a href="/personnaliser">Personnaliser ses cartes</a>
        </div>
        <div class="footer-note">
          <Icon name="heart" size={27} />
          <p>
            Des cartes à partager.
            <br />À son rythme. Avec tendresse.
          </p>
          <span>
            Paiement via <strong>stripe</strong>
          </span>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>
          © {new Date().getFullYear()} {SITE_NAME}
        </span>
        <div>
          <a href="/informations#mentions">Mentions légales</a>
          <a href="/informations#confidentialite">Confidentialité</a>
          <a href="/informations#conditions">Conditions de vente</a>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
      const menu = document.querySelector<HTMLElement>("#mobile-nav");
      function closeMenu() {
        if (menu && toggle) {
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", "Ouvrir le menu");
        }
      }
      toggle?.addEventListener("click", () => {
        if (!menu) return;
        menu.hidden = !menu.hidden;
        toggle.setAttribute("aria-expanded", String(!menu.hidden));
        toggle.setAttribute(
          "aria-label",
          menu.hidden ? "Ouvrir le menu" : "Fermer le menu",
        );
      });
      menu
        ?.querySelectorAll("a")
        .forEach((a) => a.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu && !menu.hidden) {
          closeMenu();
          toggle?.focus();
        }
      });
    </script>
  </body>
</html>
