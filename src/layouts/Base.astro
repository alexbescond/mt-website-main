---
import { getI18n, locales, languageNames, localeTags, localizedPath, unlocalizedPath, messages } from "../lib/i18n";
const { locale, t, localPath } = getI18n(Astro.url);
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/fraunces";
import "../styles/site.css";
import "../styles/postcards.css";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import { SITE_NAME } from "../lib/catalog";
interface Props {
  title?: string;
  description?: string;
  minimal?: boolean;
}
const {
  title = t("Ses petits compagnons, de très grandes aventures"),
  description = t("De 1 à 5 cartes postales personnalisées avec le doudou ou la tétine de votre enfant. Une carte expédiée chaque semaine, dès 5 € la carte par 5."),
  minimal = false,
} = Astro.props;
const path = unlocalizedPath(Astro.url.pathname);
const canonical = new URL(localPath(path), Astro.site);
const languageLinks = locales.map(language => ({ language, href: localizedPath(path, language) }));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {t(SITE_NAME)}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {path !== "/admin" && languageLinks.map(({ language, href }) => <link rel="alternate" hreflang={language} href={new URL(href, Astro.site)} />)}
    {path !== "/admin" && <link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site)} />}
    <meta property="og:title" content={`${title} | ${t(SITE_NAME)}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeTags[locale].replace("-", "_")} />
    {locales.filter(language => language !== locale).map(language => <meta property="og:locale:alternate" content={localeTags[language].replace("-", "_")} />)}
    <meta
      property="og:image"
      content={new URL("/images/compagnons-voyage.webp", Astro.site)}
    />
  </head>
  <body>
    <script id="i18n-messages" type="application/json" set:html={JSON.stringify(messages[locale]).replace(/</g, "\\u003c")} />
    <a class="skip-link" href="#contenu">{t(" Aller au contenu ")}</a>
    <div class="announcement">
      <Icon name="sparkles" size={14} />
      <span>{t("De petits compagnons. Des souvenirs pour longtemps.")}</span>
      <Icon name="sparkles" size={14} />
    </div>
    <header class="site-header wrap">
      <Logo />
      {path !== "/admin" && <details class="language-switch">
        <summary aria-label={t("Langue")}>{languageNames[locale]} <span aria-hidden="true">⌄</span></summary>
        <nav aria-label={t("Langue")}>
          {languageLinks.map(({ language, href }) => <a href={`${href}?lang=${language}`} lang={language} hreflang={language} data-language={language} aria-current={language === locale ? "true" : undefined}>{languageNames[language]}</a>)}
        </nav>
      </details>}
      {!minimal && (
        <nav class="desktop-nav" aria-label={t("Navigation principale")}>
          <a
            href={localPath("/aventures")}
            aria-current={path === "/aventures" ? "page" : undefined}
          >{t(" Les aventures ")}</a>
          <a href={localPath("/#comment-ca-marche")}>{t("Le concept")}</a>
          <a
            href={localPath("/notre-histoire")}
            aria-current={path === "/notre-histoire" ? "page" : undefined}
          >{t(" Notre histoire ")}</a>
          <a href={localPath("/#tarifs")}>{t("Les tarifs")}</a>
          <a href={localPath("/#questions")}>{t("Vos questions")}</a>
        </nav>
      )}
      <a
        class={minimal ? "back-link" : "button button-small header-cta"}
        href={localPath(minimal ? "/aventures" : "/personnaliser")}
      >
        {minimal ? t("← Les aventures") : t("Créer ses cartes")}
        {!minimal && <Icon name="arrow" size={16} />}
      </a>
      {!minimal && (
        <button
          class="menu-toggle icon-button"
          id="menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label={t("Ouvrir le menu")}
        >
          <span></span>
          <span></span>
        </button>
      )}
    </header>
    {!minimal && (
      <nav
        id="mobile-nav"
        class="mobile-nav"
        aria-label={t("Navigation mobile")}
        hidden
      >
        <a href={localPath("/aventures")}>{t("Les aventures")}</a>
        <a href={localPath("/#comment-ca-marche")}>{t("Le concept")}</a>
        <a href={localPath("/notre-histoire")}>{t("Notre histoire")}</a>
        <a href={localPath("/#tarifs")}>{t("Les tarifs")}</a>
          <a href={localPath("/#questions")}>{t("Vos questions")}</a>
        <a href={localPath("/personnaliser")}>{t("Créer ses cartes →")}</a>
      </nav>
    )}
    <main id="contenu">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-top">
        <div>
          <Logo />
          <p>{t(" Leurs petits compagnons ont tant ")}<br />{t(" de petits mots à leur envoyer. ")}</p>
        </div>
        <div class="footer-links">
          <span class="eyebrow">{t("PARTIR À LA DÉCOUVERTE")}</span>
          <a href={localPath("/aventures")}>{t("Toutes les aventures")}</a>
          <a href={localPath("/#comment-ca-marche")}>{t("Comment ça marche")}</a>
          <a href={localPath("/notre-histoire")}>{t("Notre histoire")}</a>
        </div>
        <div class="footer-links">
          <span class="eyebrow">{t("PRÉPARER LE VOYAGE")}</span>
          <a href={localPath("/#questions")}>{t("Questions fréquentes")}</a>
          <a href={localPath("/informations#confidentialite")}>{t(" Vos photos, votre confiance ")}</a>
          <a href={localPath("/personnaliser")}>{t("Personnaliser ses cartes")}</a>
          <a href={localPath("/suivi")}>{t("Suivre mes cartes")}</a>
        </div>
        <div class="footer-note">
          <Icon name="heart" size={27} />
          <p>{t(" Des cartes à partager. ")}<br />{t("À son rythme. Avec tendresse. ")}</p>
          <span>{t(" Paiement via ")}<strong>stripe</strong>
          </span>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>
          © {new Date().getFullYear()} {t(SITE_NAME)}
        </span>
        <div>
          <a href={localPath("/informations#mentions")}>{t("Mentions légales")}</a>
          <a href={localPath("/informations#confidentialite")}>{t("Confidentialité")}</a>
          <a href={localPath("/informations#conditions")}>{t("Conditions de vente")}</a>
        </div>
      </div>
    </footer>
    <script>
    import { t } from "../scripts/i18n";
    import { isLocale } from "../lib/i18n/core";
    const current = new URL(location.href);
    if (isLocale(current.searchParams.get("lang"))) {
      current.searchParams.delete("lang");
      history.replaceState(history.state, "", current.pathname + current.search + current.hash);
    }
    document.querySelectorAll<HTMLAnchorElement>("[data-language]").forEach(link => {
      const target = new URL(link.href);
      target.search = current.search;
      target.searchParams.set("lang", link.dataset.language!);
      target.hash = current.hash;
      link.href = target.href;
    });
      const toggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
      const menu = document.querySelector<HTMLElement>("#mobile-nav");
      function closeMenu() {
        if (menu && toggle) {
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", t("Ouvrir le menu"));
        }
      }
      toggle?.addEventListener("click", () => {
        if (!menu) return;
        menu.hidden = !menu.hidden;
        toggle.setAttribute("aria-expanded", String(!menu.hidden));
        toggle.setAttribute(
          "aria-label",
          menu.hidden ? t("Ouvrir le menu") : t("Fermer le menu"),
        );
      });
      menu
        ?.querySelectorAll("a")
        .forEach((a) => a.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu && !menu.hidden) {
          closeMenu();
          toggle?.focus();
        }
      });
    </script>
  </body>
</html>
