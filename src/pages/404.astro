---
import { getI18n } from "../lib/i18n";
const { t, localPath } = getI18n(Astro.url);
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base title={t("Cette page est partie en vacances")} minimal>
  <section class="wrap status-page">
    <Icon name="pin" size={48} />
    <span class="eyebrow">{t("ERREUR 404 · PETIT DÉTOUR")}</span>
    <h1>{t(" Cette page est partie ")}<br />
      <em>{t("en vacances.")}</em>
    </h1>
    <p>{t("Retrouvons le chemin des belles histoires.")}</p>
    <a href={localPath("/")} class="button">{t(" Retour aux aventures ")}<Icon name="arrow" size={18} />
    </a>
  </section>
</Base>
