---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { adventures, companions, dispatchLabel } from "../lib/catalog";
import CardPacks from "../components/CardPacks.astro";
import "../styles/order.css";
---

<Base title="Créez ses cartes postales" minimal>
  <div class="wrap order-page">
    <div class="order-heading">
      <span class="eyebrow">DES NOUVELLES RIEN QUE POUR LUI</span>
      <h1>
        Préparons le voyage
        <br />
        de <em>son compagnon.</em>
      </h1>
      <p>De 1 à 5 cartes, une aventure à découvrir chaque semaine.</p>
    </div>
    <div id="mode-notice" class="notice" role="status">
      Chargement du parcours…
    </div>
    <noscript>
      <p class="notice">
        Activez JavaScript pour personnaliser vos cartes et joindre vos photos.
      </p>
    </noscript>
    <div id="cancel-notice" class="notice" hidden>
      Le paiement a été interrompu. Aucun paiement n’est confirmé. Vous pouvez
      reprendre votre commande ci-dessous.
    </div>
    <ol class="order-steps" aria-label="Étapes de personnalisation">
      <li aria-current="step">
        <span>1</span> Ses cartes
      </li>
      <li>
        <span>2</span> La livraison
      </li>
      <li>
        <span>3</span> Le récapitulatif
      </li>
    </ol>
    <div class="order-grid">
      <form id="order-form" novalidate>
        <section data-step="0" class="form-panel">
          <h2 tabindex="-1">Faisons connaissance.</h2>
          <p class="form-intro">
            Tout commence par votre enfant et le petit héros de son histoire.
          </p>
          <fieldset class="companion-field">
            <legend>Qui sera le héros de son histoire ?</legend>
            <div class="companion-options">
              {Object.entries(companions).map(([id, companion]) => (
                <label class="companion-option">
                  <input
                    type="radio"
                    name="companion"
                    value={id}
                    checked={id === "tetine"}
                    required
                  />
                  <strong>{companion.label}</strong>
                  <span>{companion.description}</span>
                </label>
              ))}
            </div>
          </fieldset>
          <label class="field">
            Le petit nom de son compagnon{" "}
            <span class="optional">facultatif</span>
            <input
              name="companionName"
              autocomplete="off"
              maxlength="60"
              placeholder="Par exemple, Lapinou ou Titi"
            />
            <small>Un surnom que l’on pourra glisser dans l’histoire.</small>
          </label>
          <fieldset class="pack-field">
            <legend>Combien de cartes pour son voyage ?</legend>
            <CardPacks selectable />
            <p class="form-intro">Un paiement unique. Frais de port inclus en France métropolitaine. Aucun abonnement.</p>
          </fieldset>
          <fieldset class="destination-field">
            <legend>Ses aventures, dans l’ordre des envois</legend>
            <p class="form-intro" id="adventure-help">Choisissez une aventure différente pour chaque carte. Les aventures déjà choisies sont grisées dans les autres menus. Après le premier envoi, les suivants sont espacés de 7 jours.</p>
            {[0, 1, 2, 3, 4].map((index) => (
              <label class="field adventure-field" data-card-index={index} hidden={index > 0}>
                {index === 0 ? "Quelle destination pour son compagnon ?" : `Carte ${index + 1} · ${dispatchLabel(index)}`}
                <select id={`adventure-${index + 1}`} name="adventure" required disabled={index > 0} aria-describedby="adventure-help">
                  {Object.entries(adventures).map(([id, item], adventureIndex) => <option value={id} selected={adventureIndex === index}>{item.short}</option>)}
                </select>
                {index === 0 && <small>Carte 1 · Premier envoi</small>}
              </label>
            ))}
          </fieldset>
          <label class="field">
            Le prénom de votre enfant <span class="required">*</span>
            <input
              name="childName"
              autocomplete="off"
              maxlength="60"
              placeholder="Par exemple, Camille"
              required
            />
            <small>Il apparaîtra dans les petits mots de son compagnon.</small>
          </label>
          <div class="upload-field">
            <label for="pacifierPhoto">
              <span id="companion-photo-label">La photo de sa tétine</span>{" "}
              <span class="required">*</span>
            </label>
            <p>
              De face, bien éclairée, sur un fond simple : on veut reconnaître
              tous ses petits détails.
            </p>
            <label class="upload-zone" for="pacifierPhoto">
              <Icon name="camera" size={28} />
              <span class="upload-title">Choisir une photo de Tétine</span>
              <small>JPG, PNG ou WebP · 5 Mo maximum</small>
              <input
                id="pacifierPhoto"
                name="pacifierPhoto"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                required
                aria-describedby="pacifier-error photo-use-notice"
              />
              <img
                class="upload-preview"
                alt="Aperçu de la photo de son compagnon"
                hidden
              />
            </label>
            <span
              id="pacifier-error"
              class="field-error"
              aria-live="polite"
            ></span>
            <p id="photo-use-notice">
              La photo de son compagnon sert uniquement à créer vos cartes.{" "}
              <a
                href="/informations#confidentialite"
                target="_blank"
                rel="noopener"
              >En savoir plus sur les photos</a>.
            </p>
          </div>
          <label class="field">
            Un petit mot pour notre équipe{" "}
            <span class="optional">facultatif</span>
            <textarea
              name="notes"
              rows="3"
              maxlength="500"
              placeholder="Une petite habitude, un détail qui compte, une préférence…"
            ></textarea>
          </label>
        </section>
        <section data-step="1" class="form-panel" hidden>
          <h2 tabindex="-1">
            À quelle adresse
            <br />
            envoyer son aventure ?
          </h2>
          <p class="form-intro">
            Une carte à la fois dans la boîte aux lettres, puis un petit mot à
            lire ensemble.
          </p>
          <div class="field-row">
            <label class="field">
              Votre prénom <span class="required">*</span>
              <input
                name="firstName"
                autocomplete="given-name"
                maxlength="80"
                required
              />
            </label>
            <label class="field">
              Votre nom <span class="required">*</span>
              <input
                name="lastName"
                autocomplete="family-name"
                maxlength="80"
                required
              />
            </label>
          </div>
          <label class="field">
            Votre adresse e-mail <span class="required">*</span>
            <input
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              required
              placeholder="vous@exemple.fr"
            />
            <small>Pour associer votre paiement à votre commande.</small>
          </label>
          <label class="field">
            Adresse de livraison <span class="required">*</span>
            <input
              name="address"
              autocomplete="address-line1"
              maxlength="150"
              required
              placeholder="Numéro et nom de la rue"
            />
          </label>
          <label class="field">
            Complément d’adresse <span class="optional">facultatif</span>
            <input
              name="addressExtra"
              autocomplete="address-line2"
              maxlength="150"
              placeholder="Appartement, bâtiment, étage…"
            />
          </label>
          <div class="field-row">
            <label class="field">
              Code postal <span class="required">*</span>
              <input
                name="postalCode"
                autocomplete="postal-code"
                inputmode="numeric"
                pattern="[0-9]{5}"
                maxlength="5"
                required
              />
            </label>
            <label class="field">
              Ville <span class="required">*</span>
              <input
                name="city"
                autocomplete="address-level2"
                maxlength="100"
                required
              />
            </label>
          </div>
          <label class="field">
            Pays
            <select name="country" autocomplete="country">
              <option value="FR">France métropolitaine</option>
            </select>
            <small>
              Cette première version propose la livraison en France
              métropolitaine.
            </small>
          </label>
        </section>
        <section data-step="2" class="form-panel" hidden>
          <h2 tabindex="-1">
            Tout est prêt
            <br />
            pour le grand départ.
          </h2>
          <p class="form-intro">
            Un dernier regard avant de laisser la magie commencer.
          </p>
          <div class="review-section">
            <div>
              <h3>Ses cartes</h3>
              <button type="button" class="edit-button" data-edit="0">
                Modifier
              </button>
            </div>
            <p id="review-book"></p>
            <ol id="review-plan" class="dispatch-plan"></ol>
            <p id="review-child"></p>
            <p id="review-companion"></p>
            <div class="review-photos" id="review-photos"></div>
            <p id="review-notes"></p>
          </div>
          <div class="review-section">
            <div>
              <h3>La livraison</h3>
              <button type="button" class="edit-button" data-edit="1">
                Modifier
              </button>
            </div>
            <p id="review-address"></p>
            <p id="review-email"></p>
          </div>
          <label class="checkbox-field">
            <input type="checkbox" name="termsConsent" required />
            <span>
              J’ai vérifié mes informations et j’accepte les{" "}
              <a href="/informations#conditions" target="_blank" rel="noopener">
                conditions de vente
              </a>{" "}
              et la{" "}
              <a
                href="/informations#confidentialite"
                target="_blank"
                rel="noopener"
              >
                politique de confidentialité
              </a>
              .
            </span>
          </label>
          <p class="payment-note" id="payment-note">
            La démonstration ne déclenche aucun paiement.
          </p>
        </section>
        <div id="form-error" role="alert" class="form-error" hidden></div>
        <div class="form-actions">
          <button
            type="button"
            id="previous-step"
            class="button button-secondary"
            hidden
          >
            ← Retour
          </button>
          <button type="submit" id="next-step" class="button" disabled>
            Continuer <Icon name="arrow" size={18} />
          </button>
        </div>
        <p class="required-note">
          * Les informations nécessaires à la création de vos cartes.
        </p>
      </form>
      <aside class="order-summary">
        <div class="summary-photo" id="summary-single">
          <img
            id="summary-image"
            src={adventures.tropiques.image}
            width="600"
            height="400"
            alt="Aperçu illustratif de l’aventure choisie"
          />
          <span id="summary-caption">EXEMPLE ILLUSTRÉ AVEC TÉTINE</span>
        </div>
        <div class="summary-bundle" id="summary-bundle" hidden>
          <span class="eyebrow">SON VOYAGE, CARTE APRÈS CARTE</span>
          <ol id="summary-cards" class="summary-cards" aria-label="Aperçus des cartes dans l’ordre des envois"></ol>
          <p id="summary-bundle-caption" class="summary-bundle-caption"></p>
        </div>
        <div class="summary-body">
          <span class="eyebrow">SA PETITE CORRESPONDANCE</span>
          <h2 id="summary-title">{adventures.tropiques.title}</h2>
          <p id="summary-child">L’histoire de son compagnon</p>
          <ul>
            <li>
              <Icon name="check" size={17} /> Son compagnon sur chaque carte
            </li>
            <li>
              <Icon name="check" size={17} /> Un petit mot avec son prénom
            </li>
            <li>
              <Icon name="check" size={17} /> Une vraie carte postale à garder
            </li>
          </ul>
          <p id="summary-cadence" class="summary-cadence">Un envoi postal</p>
          <div class="summary-line">
            <span id="summary-quantity">1 carte × 7,00 €</span>
            <span id="summary-subtotal">7,00 €</span>
          </div>
          <div class="summary-line">
            <span>Livraison</span>
            <span>Incluse</span>
          </div>
          <div class="summary-total">
            <span>Total</span>
            <strong id="summary-total" aria-live="polite">7,00 €</strong>
          </div>
          <span class="price-provisional">
            Paiement unique · Aucun abonnement
          </span>
          <div class="summary-reassurance">
            <Icon name="lock" size={17} />
            <span>Photos privées · Paiement via Stripe</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
  <script src="../scripts/order.ts"></script>
</Base>
