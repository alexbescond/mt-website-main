# Duplicate this file as .dev.vars only for manual Stripe sandbox integration.
# The demo works without any credentials. Never commit real secret values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_PASSWORD=
TRACKING_LINK_SECRET=
# Keep local email sending disabled. Staging/test and production/live send real
# emails through Resend when EMAIL_ENABLED=true and the required secrets exist.
EMAIL_ENABLED=false
RESEND_API_KEY=
